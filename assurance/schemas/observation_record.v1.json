{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observation_record.v1.json",
  "description": "Strict ingestion and checked Rust eligibility are required; a schema match grants no qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "subject",
    "material_state",
    "model",
    "observable",
    "value",
    "unit",
    "frame",
    "region",
    "recovery",
    "raw_source",
    "origin",
    "physical_validation",
    "uncertainty"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "material_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observable": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "enum": [
        "dimensionless",
        "gram",
        "millimetre",
        "newton",
        "newton_millimetre",
        "newton_per_gram",
        "megapascal",
        "second",
        "celsius"
      ]
    },
    "frame": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "recovery": {
      "type": "string",
      "minLength": 1
    },
    "raw_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "origin": {
      "enum": [
        "simulation",
        "measurement",
        "synthetic"
      ]
    },
    "physical_validation": {
      "enum": [
        "not_performed",
        "validated",
        "invalid"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "amount",
          "method",
          "domain",
          "dependence",
          "coverage_interpretation"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "dependence": {
            "type": "string",
            "minLength": 1
          },
          "coverage_interpretation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
