{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence.v2.json",
  "description": "Strict ingestion and checked Rust eligibility are required; a schema match grants no qualification. Qualified source bytes must also match $defs/source_record and the observation exactly; bare historical scalars stay nonqualifying.",
  "$defs": {
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scientific_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "subject",
        "requirements",
        "source",
        "build",
        "cargo_lock",
        "config",
        "evaluator",
        "scenario",
        "objective",
        "descriptor",
        "material",
        "dependencies"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "subject": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "representation",
                "bits"
              ],
              "properties": {
                "kind": {
                  "const": "genome"
                },
                "representation": {
                  "$ref": "#/$defs/content_ref"
                },
                "bits": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "artifact",
                "geometry_state",
                "format",
                "unit"
              ],
              "properties": {
                "kind": {
                  "const": "native_cad"
                },
                "artifact": {
                  "$ref": "#/$defs/content_ref"
                },
                "geometry_state": {
                  "$ref": "#/$defs/content_ref"
                },
                "format": {
                  "enum": [
                    "step",
                    "stl"
                  ]
                },
                "unit": {
                  "enum": [
                    "millimetre",
                    "metre"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "passport"
              ],
              "properties": {
                "kind": {
                  "const": "specimen"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "passport": {
                  "$ref": "#/$defs/content_ref"
                }
              }
            }
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          }
        },
        "source": {
          "$ref": "#/$defs/content_ref"
        },
        "build": {
          "$ref": "#/$defs/content_ref"
        },
        "cargo_lock": {
          "$ref": "#/$defs/content_ref"
        },
        "config": {
          "$ref": "#/$defs/content_ref"
        },
        "evaluator": {
          "$ref": "#/$defs/content_ref"
        },
        "scenario": {
          "$ref": "#/$defs/content_ref"
        },
        "objective": {
          "$ref": "#/$defs/content_ref"
        },
        "descriptor": {
          "$ref": "#/$defs/content_ref"
        },
        "material": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "passport"
              ],
              "properties": {
                "status": {
                  "const": "identified"
                },
                "passport": {
                  "$ref": "#/$defs/content_ref"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_ref"
          }
        }
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "producer",
        "value",
        "not_applicable_reason",
        "origin",
        "evidence_class",
        "state",
        "dependencies",
        "uncertainty",
        "identity_sha256"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "not_applicable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "simulation",
            "measurement",
            "synthetic"
          ]
        },
        "evidence_class": {
          "enum": [
            "software_contract",
            "numerical_verification",
            "physical_validation",
            "research"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution",
            "numerical",
            "validation"
          ],
          "properties": {
            "execution": {
              "enum": [
                "succeeded",
                "failed",
                "not_run"
              ]
            },
            "numerical": {
              "enum": [
                "verified",
                "unverified",
                "invalid"
              ]
            },
            "validation": {
              "enum": [
                "not_performed",
                "validated",
                "invalid"
              ]
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "amount",
              "method",
              "domain",
              "dependence",
              "coverage_interpretation"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.7976931348623157e+308
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "dependence": {
                "type": "string",
                "minLength": 1
              },
              "coverage_interpretation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_set",
        "group"
      ],
      "properties": {
        "requirement_set": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_receipt": {
      "description": "Closed content-bound receipt; qualifying approval additionally requires opaque trusted caller admission, never incoming labels or a self-rehash. No signature guarantee is provided.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sequence",
        "observation",
        "observation_sha256",
        "action",
        "reviewer",
        "scope"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "enum": [
            "approved",
            "reopened",
            "revoked",
            "superseded"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/review_scope"
        }
      }
    },
    "review_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "observation",
        "observation_sha256",
        "action",
        "reviewer",
        "scope",
        "receipt"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "enum": [
            "approved",
            "reopened",
            "revoked",
            "superseded"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/review_scope"
        },
        "receipt": {
          "$ref": "#/$defs/content_ref"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "producer",
    "identity",
    "value",
    "not_applicable_reason",
    "source",
    "origin",
    "evidence_class",
    "state",
    "dependencies",
    "uncertainty"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific",
        "model",
        "observable"
      ],
      "properties": {
        "scientific": {
          "$ref": "#/$defs/scientific_identity"
        },
        "model": {
          "$ref": "#/$defs/content_ref"
        },
        "observable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "unit",
            "frame",
            "region",
            "recovery"
          ],
          "properties": {
            "quantity": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "enum": [
                "dimensionless",
                "gram",
                "millimetre",
                "newton",
                "newton_millimetre",
                "newton_per_gram",
                "megapascal",
                "second",
                "celsius"
              ]
            },
            "frame": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "recovery": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "value": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        {
          "type": "null"
        }
      ]
    },
    "not_applicable_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "$ref": "#/$defs/content_ref"
    },
    "origin": {
      "enum": [
        "simulation",
        "measurement",
        "synthetic"
      ]
    },
    "evidence_class": {
      "enum": [
        "software_contract",
        "numerical_verification",
        "physical_validation",
        "research"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "numerical",
        "validation"
      ],
      "properties": {
        "execution": {
          "enum": [
            "succeeded",
            "failed",
            "not_run"
          ]
        },
        "numerical": {
          "enum": [
            "verified",
            "unverified",
            "invalid"
          ]
        },
        "validation": {
          "enum": [
            "not_performed",
            "validated",
            "invalid"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "amount",
          "method",
          "domain",
          "dependence",
          "coverage_interpretation"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.7976931348623157e+308
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "dependence": {
            "type": "string",
            "minLength": 1
          },
          "coverage_interpretation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
