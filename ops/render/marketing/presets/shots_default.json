 "defaults": {"finish_preset": "finish_ti64", "accents": [], "sensor_mm": 36, "fill": [0.62, 0.78], "margin": 0.06, "pose": "as_is", "still_res": [[3840, 2160], [1920, 1080]]},
 "stills": [
  {"id": "hero_3q",      "rig": "rig_studio_softbox", "az": 35,  "el": 20, "camera": {"focal_mm": 85,  "fstop": 5.6, "dof_policy": "whole_object"}, "target": null, "fill": [0.62, 0.78]},
  {"id": "profile_flat", "rig": "rig_studio_softbox", "az": 0,   "el": 0,  "camera": {"focal_mm": 200, "fstop": 8.0, "dof_policy": "whole_object"}, "target": null},
  {"id": "spine_top",    "rig": "rig_studio_softbox", "az": 0,   "el": 75, "camera": {"focal_mm": 85,  "fstop": 5.6, "dof_policy": "whole_object"}, "target": null},
