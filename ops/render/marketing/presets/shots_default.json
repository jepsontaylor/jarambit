  {"id": "ring_detail",  "rig": "rig_studio_softbox", "az": 20,  "el": 15, "camera": {"focal_mm": 135, "fstop": 4.0, "dof_policy": "fixed", "focus_point": "target"}, "target": "auto:ring,bevel", "field_mm": 70},
  {"id": "dark_hero",    "rig": "rig_dark_strip",     "az": 30,  "el": 8,  "camera": {"focal_mm": 85,  "fstop": 5.6, "dof_policy": "whole_object"}, "target": null},
