  {"id": "flat_lay",     "rig": "rig_studio_softbox", "az": 0,   "el": 90, "camera": {"focal_mm": 85,  "fstop": 8.0, "dof_policy": "whole_object"}, "target": null, "pose": "lay_flat", "roll_deg": 0}
