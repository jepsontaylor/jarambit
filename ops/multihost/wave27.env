# wave27 search environment (from docs/wave27_diversity/run_w27.sh). JARAMBIT_P1 must be unset. Mass cap is per job (soft G penalty).
JARAMBIT_W21=1
JARAMBIT_W22=1
JARAMBIT_TIPSPG_REF=5.48
JARAMBIT_TIP_CAP=1.6
JARAMBIT_T_MAX=6.0
JARAMBIT_CERT_STRICT=1
JARAMBIT_TIPZONE_KC=1.01
JARAMBIT_HOLDER_LOOSEN_MM=1.0
CUDA_VISIBLE_DEVICES=
JARAMBIT_TIPTWIST_GATE=1
